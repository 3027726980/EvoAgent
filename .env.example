EVOAGENT_HOST=127.0.0.1
EVOAGENT_PORT=8080
EVOAGENT_DB_PATH=evoagent.db
EVOAGENT_MAX_DIFF_BYTES=1048576
EVOAGENT_MAX_STEPS=8
EVOAGENT_TIMEOUT_SECONDS=120

# 本地使用默认关闭登录；对外提供服务前应启用认证。
EVOAGENT_AUTH_REQUIRED=false
EVOAGENT_AUTH_SECRET=
EVOAGENT_BOOTSTRAP_ADMIN_USERNAME=
EVOAGENT_BOOTSTRAP_ADMIN_PASSWORD=
EVOAGENT_DEFAULT_TENANT_ID=default
EVOAGENT_SESSION_TTL_SECONDS=3600

# 模型提供商：local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local 保持仅使用确定性规则的审查器。
EVOAGENT_LLM_PROVIDER=local

EVOAGENT_ENABLED_AGENTS=lead,security,correctness-reliability,critic
EVOAGENT_AGENT_TOKEN_BUDGET=8000
EVOAGENT_AGENT_TIME_BUDGET_SECONDS=60
# 请求前检查语义上下文预算，输入与输出令牌总数应低于模型窗口。
EVOAGENT_AGENT_CONTEXT_WINDOW_TOKENS=32768
EVOAGENT_AGENT_CONTEXT_INPUT_TOKENS=20000
EVOAGENT_CONTEXT_DIFF_TOKEN_BUDGET=12000
EVOAGENT_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
EVOAGENT_CONTEXT_RECENT_OBSERVATIONS=2
EVOAGENT_CONTEXT_MAP_CHUNK_TOKENS=3000
# 配置当前提供商的计价参数，使报告能够统计非零调用费用。
EVOAGENT_LLM_INPUT_COST_PER_MILLION=0
EVOAGENT_LLM_OUTPUT_COST_PER_MILLION=0

# DeepSeek 官方付费接口，默认模型为 deepseek-v4-flash。
EVOAGENT_DEEPSEEK_API_KEY=

# OpenRouter 免费预设：需要 API 密钥，限流较严且可用性可能变化。
EVOAGENT_OPENROUTER_API_KEY=
EVOAGENT_OPENROUTER_SITE_URL=
EVOAGENT_OPENROUTER_APP_NAME=EvoAgent

# 自定义 OpenAI 兼容 Chat Completions 接口，以下三项均必填。
EVOAGENT_LLM_BASE_URL=
EVOAGENT_LLM_API_KEY=
EVOAGENT_LLM_MODEL=

# 回放评测与演进版本激活门禁。
EVOAGENT_EVAL_MAX_CASES=5
EVOAGENT_EVAL_MIN_CASES=3
EVOAGENT_EVAL_MIN_HOLDOUT_CASES=2
EVOAGENT_EVAL_MIN_IMPROVEMENT=0.01
EVOAGENT_EVAL_MAX_METRIC_REGRESSION=0
EVOAGENT_EVALUATION_MIN_PUBLIC_PRS=300
EVOAGENT_EVALUATION_MIN_F1_IMPROVEMENT=0.03
EVOAGENT_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub 集成配置。
EVOAGENT_GITHUB_WEBHOOK_SECRET=
EVOAGENT_GITHUB_TOKEN=
EVOAGENT_AUTO_POST_REVIEW=false
EVOAGENT_WEBHOOK_MAX_AGE_SECONDS=600

# 生产持久化与任务队列；留空时使用 SQLite 和进程内队列。
EVOAGENT_DATABASE_URL=
EVOAGENT_REDIS_URL=
EVOAGENT_ASYNC_WORKERS=2
EVOAGENT_QUEUE_MAX_ATTEMPTS=3
EVOAGENT_QUEUE_LEASE_SECONDS=60
EVOAGENT_SKILLS_DIR=skills

# 修复验证与可观测性配置。
EVOAGENT_REPAIR_TEST_COMMAND=
EVOAGENT_REPAIR_VERIFY_TIMEOUT_SECONDS=120
EVOAGENT_MEMORY_ENABLED=true
EVOAGENT_MEMORY_RECALL_LIMIT=6
EVOAGENT_MEMORY_WORKING_TTL_SECONDS=86400
EVOAGENT_OTEL_ENDPOINT=
EVOAGENT_OTEL_SERVICE_NAME=evoagent
EVOAGENT_ALERT_FAILURE_RATE=0.20
EVOAGENT_ALERT_MIN_SAMPLES=10

# GitHub 应用配置：安装入口为 /github/install，回调为 /github/setup。
EVOAGENT_GITHUB_APP_ID=
EVOAGENT_GITHUB_APP_SLUG=
EVOAGENT_GITHUB_PRIVATE_KEY_PATH=
EVOAGENT_PUBLIC_BASE_URL=http://127.0.0.1:8080
